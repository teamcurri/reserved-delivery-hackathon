# Public URL of the web app — embedded in the QR code shown on desktop.
# Local dev: leave as is. ngrok: set to your tunnel URL.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Optional: override the internal URL Next.js rewrites server requests to.
# Defaults to http://localhost:4000 (matches apps/server/.env PORT).
# SERVER_INTERNAL_URL=http://localhost:4000
